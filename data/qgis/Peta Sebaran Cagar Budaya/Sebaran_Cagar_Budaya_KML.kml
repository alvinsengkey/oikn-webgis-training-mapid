		<SimpleData name="id_objekcb">PO2015052700001</SimpleData>
		<SimpleData name="nm_objekcb">Masjid R. Sayyid Kuning</SimpleData>
		<SimpleData name="nm_kategoricb">Bangunan</SimpleData>
		<SimpleData name="slug_kategori">bangunan</SimpleData>
		<SimpleData name="deskripsi">Masjid Raden Sayid Kuning didirikan pada masa kekuasaan Kerajaan 
 Demak Bintoro oleh seorang murid Sunan Kalijaga yang bernama Raden 
Sayid Kuning, Tokoh ulama yang menyebarkan agama Islam di daerah Purbalingga dan sekitarnya, sekaligus tokoh ajaran penghitungan tahun dengan sistim aboge.
</SimpleData>
		<SimpleData name="district">Kabupaten Purbalingga</SimpleData>
		<SimpleData name="province">Jawa Tengah</SimpleData>
