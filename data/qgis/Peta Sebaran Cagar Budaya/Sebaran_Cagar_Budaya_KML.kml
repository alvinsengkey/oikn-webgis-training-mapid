  <Placemark>
	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2016051800013</SimpleData>
		<SimpleData name="nm_objekcb">Makam Jeurat Panjang</SimpleData>
		<SimpleData name="nm_kategoricb">Situs</SimpleData>
		<SimpleData name="slug_kategori">situs</SimpleData>
		<SimpleData name="deskripsi">Makam ini berorientasi Utara Selatan yang dilengkapi dengan sepasang nisa tanpa jirat. Nisan tersebut dibentuk dari batu pasir bertipe gada segi 8, berukuran tinggi 50 cm, nisan terbagi menjadi 3 bagian yaitu kaki berbentuk persegi empat, bagian badan berbentuk persegi 8, dan bagian puncak berbentuk kelopak-kelopak bunga dan diakhiri dengan ujung meruncing.</SimpleData>
		<SimpleData name="district">Kabupaten Aceh Tamiang</SimpleData>
		<SimpleData name="province">Aceh</SimpleData>
	</SchemaData></ExtendedData>
