	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2016071100005</SimpleData>
		<SimpleData name="nm_objekcb">Gereja Kyai Sadrah</SimpleData>
		<SimpleData name="nm_kategoricb">Bangunan</SimpleData>
		<SimpleData name="slug_kategori">bangunan</SimpleData>
		<SimpleData name="deskripsi">Bangunan Gereja yang dilengkapi bangunan rumah tinggal, bangunan rumah sebagai rumah tinggal terletak di sebelah selatan gereja dan pendopo dengan bahan dasar batu.  Sumur kuno terletak di sebelah barat laut gereja. </SimpleData>
