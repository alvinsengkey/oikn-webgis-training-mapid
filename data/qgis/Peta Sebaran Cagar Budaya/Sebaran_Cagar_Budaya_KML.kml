  </Placemark>
  <Placemark>
	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2016061000081</SimpleData>
		<SimpleData name="nm_objekcb">Pengindelan Abang</SimpleData>
		<SimpleData name="nm_kategoricb">Struktur</SimpleData>
		<SimpleData name="slug_kategori">struktur</SimpleData>
		<SimpleData name="deskripsi">Bangunan Pangindelan Abang memiliki panjang
bangunan ini 18,20 meter, lebar 5,64 meter, tinggi 3,45
meter, tebal dinding 80 cm, dan luas bangunan 102, 64
m². Kedalaman lantai sekitar satu meter dari ketinggian
setempat dan mempunyai empat tiang penyangga di
dalamnya.</SimpleData>
