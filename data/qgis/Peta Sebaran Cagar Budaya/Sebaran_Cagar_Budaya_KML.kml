  <Placemark>
	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2016060900262</SimpleData>
		<SimpleData name="nm_objekcb">Kompleks Makam Sengngeng Lampe Uttu</SimpleData>
		<SimpleData name="nm_kategoricb">Situs</SimpleData>
		<SimpleData name="slug_kategori">situs</SimpleData>
		<SimpleData name="deskripsi">Secara umum bentuk makam ini berundak-undak. Nisan bervariasi, yaitu polos; berhias motif sulur daun (ikal nursal); atau berhias relief manusia dan jendela.</SimpleData>
		<SimpleData name="district">Kabupaten Bulukumba</SimpleData>
		<SimpleData name="province">Sulawesi Selatan</SimpleData>
