	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2015090300103</SimpleData>
		<SimpleData name="nm_objekcb">Masjid Jami Tambora</SimpleData>
		<SimpleData name="nm_kategoricb">Bangunan</SimpleData>
		<SimpleData name="slug_kategori">bangunan</SimpleData>
		<SimpleData name="deskripsi">Bangunan masjid masih dalam kondisi baik. Atap bangunan berupa atap tumpang dua dan limasan. Bangunan ini berlantai 1 dengan denah berbentuk persegi panjang.</SimpleData>
