	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2016061000088</SimpleData>
		<SimpleData name="nm_objekcb">Pengindelan Emas</SimpleData>
		<SimpleData name="nm_kategoricb">Struktur</SimpleData>
		<SimpleData name="slug_kategori">struktur</SimpleData>
		<SimpleData name="deskripsi">Panjang bangunan ini 17,35 meter, lebar
5,50 meter, tinggi 1,40 meter, dan tebal dinding 80 cm, dan luas
bangunan 95,425 m². Keadaan bangunan ini sudah tidak utuh,
seluruh atapnya runtuh total tetapi bagian dindingnya masih
tertinggal.</SimpleData>
