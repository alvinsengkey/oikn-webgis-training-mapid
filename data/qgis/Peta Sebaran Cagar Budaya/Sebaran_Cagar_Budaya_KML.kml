  <Placemark>
	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2014102300072</SimpleData>
		<SimpleData name="nm_objekcb">Masjid Al Wustho Mangkunegaran</SimpleData>
		<SimpleData name="nm_kategoricb">Bangunan</SimpleData>
		<SimpleData name="slug_kategori">bangunan</SimpleData>
		<SimpleData name="deskripsi">-Komplek Masjid terdiri dari 2 bagian yaitu masjid dan bangunan pendukung yaitu, maligi, menara, kantor pengurus masjid beserta tempat tinggal mereka dan perpustakaan. </SimpleData>
		<SimpleData name="district">Kota Surakarta</SimpleData>
		<SimpleData name="province">Jawa Tengah</SimpleData>
