  <Placemark>
	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2015112200096</SimpleData>
		<SimpleData name="nm_objekcb">Makam Raja Haji Abdurrakhman</SimpleData>
		<SimpleData name="nm_kategoricb">Situs</SimpleData>
		<SimpleData name="slug_kategori">situs</SimpleData>
		<SimpleData name="deskripsi">Pada nisan tertera tulisan arab yang menerangkan nama Raja Abdurrakhman dan tanggal meninggalnya, Bahan dari nisan terbuat dari batu granit dengan tipe gada.</SimpleData>
