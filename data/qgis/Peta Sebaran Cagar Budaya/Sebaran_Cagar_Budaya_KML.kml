  <Placemark>
	<ExtendedData><SchemaData schemaUrl="#Sebaran_Cagar_Budaya_KML">
		<SimpleData name="id_objekcb">PO2016051800014</SimpleData>
		<SimpleData name="nm_objekcb">Makam Tan Po Garang</SimpleData>
		<SimpleData name="nm_kategoricb">Situs</SimpleData>
		<SimpleData name="slug_kategori">situs</SimpleData>
		<SimpleData name="deskripsi">Pada komplek ini terdapat 3 buah makam yang masing-masing dibentuk dari batu pasir. Ketiga makam ini memiliki tipe nisan yang sama, yaitu balok (persegi empat) bersayap yang terdiri dari 3 bagian yaitu kaki, badan, puncak/kepala dengan panil-panil dan ornamen medalion serta sulur-suluran. KOndisi nisan sebagian besar telah aus sehingga sulit untuk mengidentifikasi kaligrafinya.</SimpleData>
		<SimpleData name="district">Kabupaten Aceh Tamiang</SimpleData>
		<SimpleData name="province">Aceh</SimpleData>
	</SchemaData></ExtendedData>
